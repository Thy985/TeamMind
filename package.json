{
  "name": "teammind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "pnpm --filter teammind-tauri tauri",
    "tauri:dev": "pnpm --filter teammind-tauri tauri dev",
    "tauri:build": "pnpm --filter teammind-tauri tauri build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "node scripts/playwright-test-runner.cjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "test:playwright:headed": "node scripts/playwright-test-runner.cjs --headed"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.0.0",
    "@types/node": "^24.12.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.2.5"
  }
}