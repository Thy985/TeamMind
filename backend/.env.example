# TeamMind Backend 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 百度千帆配置（推荐）====================

# 百度千帆 API Key（请填入你自己的 Key，勿提交真实 Key 到仓库）
QIANFAN_API_KEY=your-qianfan-api-key-here

# 百度千帆 Base URL（OpenAI 协议兼容）
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2/coding

# ==================== OpenAI 配置（可选）====================

# OpenAI API Key
OPENAI_API_KEY=

# OpenAI API 基础 URL（可选，用于代理）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 组织 ID（可选）
OPENAI_ORG=

# ==================== Anthropic 配置（可选）====================

# Anthropic API Key
ANTHROPIC_API_KEY=

# Anthropic Base URL
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ==================== 应用配置 ====================

# 服务端口
SERVER_PORT=8080

# 日志级别
LOG_LEVEL=INFO

# ==================== 安全（必填）====================

# JWT 签名密钥：必填，至少 32 字符的强随机密钥。
# 生成示例：openssl rand -base64 48
# 未设置或使用默认占位密钥时，应用将拒绝启动。
TEAMMIND_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
