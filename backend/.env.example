# TeamMind Backend 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 百度千帆配置（推荐）====================

# 百度千帆 API Key
QIANFAN_API_KEY=bce-v3/ALTAKSP-W8fnSI7P0cqEcBxE6SYuM/94fd0c1e5615d09b244576df2d68dfd0739ed5f2

# 百度千帆 Base URL（OpenAI 协议兼容）
