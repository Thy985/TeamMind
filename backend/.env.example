# ==================== Anthropic 配置（可选）====================

# Anthropic API Key
ANTHROPIC_API_KEY=

# Anthropic Base URL
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ==================== 应用配置 ====================

# 服务端口
SERVER_PORT=8080

# 日志级别
LOG_LEVEL=INFO
